# Rename this file to `keystore.properties` and fill in your release keystore
# BEFORE building a signed release APK / AAB. NEVER commit the real file.
#
# Generate a keystore locally:
#   keytool -genkey -v -keystore arrow-maze.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias arrow-maze
#
storeFile=arrow-maze.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=arrow-maze
keyPassword=YOUR_KEY_PASSWORD
